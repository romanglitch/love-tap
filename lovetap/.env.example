# ─── Local Development ──────────────────────────────────────────────────
# PostgreSQL connection string (ignored when using docker-compose)
DATABASE_URL="postgresql://user:password@localhost:5432/lovetap?schema=public"

# ─── VAPID Keys (REQUIRED) ─────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Docker Compose ─────────────────────────────────────────────────────
# Password for PostgreSQL container (docker-compose only)
DB_PASSWORD=lovetap_secret
